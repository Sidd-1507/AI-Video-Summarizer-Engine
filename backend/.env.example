# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/exam-notes-ai?retryWrites=true&w=majority

# ── Firebase (Admin SDK) ───────────────────────────────────────────────────────
# Provide EITHER the service account JSON path OR the individual fields
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or individual fields (alternative):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── LLM (Phase 1 + Phase 3 MCQ) ───────────────────────────────────────────────
# Supported: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...

# OpenAI fallback (optional)
# OPENAI_API_KEY=sk-...

# ── Imagen 3 (Phase 3) ─────────────────────────────────────────────────────────
# Uses same GEMINI_API_KEY — ensure Imagen API is enabled in AI Studio
# IMAGEN_API_KEY=AIza...  # Only if different from GEMINI_API_KEY

# ── Google Cloud TTS (Phase 3) ─────────────────────────────────────────────────
# Uses Google AI/Cloud API key with Text-to-Speech enabled
GOOGLE_TTS_API_KEY=AIza...

# ── Stripe (Phase 2) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_50CR=price_...
STRIPE_PRICE_120CR=price_...
STRIPE_PRICE_300CR=price_...

# ── Redis (BullMQ jobs) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (email/password JWT) ──────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
